[Unit]
Description=Kopi Sawah internal web app (uji)
After=network.target
Wants=network.target

[Service]
Type=simple
User=kopi-sawah
Group=kopi-sawah
WorkingDirectory=/opt/kopi-sawah
Environment=KOPI_SAWAH_PORT=8791
Environment=KOPI_SAWAH_DB=/var/lib/kopi-sawah/kopi-sawah.sqlite3
Environment=KOPI_SAWAH_REQUIRE_ORIGIN=1
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=kopi-sawah
StateDirectoryMode=0750
UMask=0027
ExecStart=/usr/bin/python3 /opt/kopi-sawah/app.py
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=15s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/kopi-sawah

[Install]
WantedBy=multi-user.target
